# ===============================================================
# NAKSHA V2.0 — Google Maps Platform Environment Configuration
# ===============================================================
# Required for Google Photorealistic 3D Tiles in CesiumJS
#
# Steps to obtain your API key:
# 1. Open Google Cloud Console: https://console.cloud.google.com/
# 2. Create or select your Google Cloud Project.
# 3. Enable Billing for the project.
# 4. In APIs & Services > Library, search for and ENABLE "Map Tiles API".
# 5. In APIs & Services > Credentials, click "+ CREATE CREDENTIALS" > "API key".
# 6. Restrict the API key to "Map Tiles API" and configure HTTP referrers if deploying to production.
# 7. Copy your API key below and save as .env:

VITE_GOOGLE_MAPS_API_KEY=your_google_maps_platform_api_key_here

# ===============================================================
# Backend API URL (Render Web Service Deployment)
# ===============================================================
# Optional: Set this in Vercel Project Settings > Environment Variables
# Example: https://naksha-backend.onrender.com
VITE_API_URL=http://localhost:3001
